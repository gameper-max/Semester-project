int vd(int vdrow , int vdcol){// 1111 = okay , 77 = not okay
    if (arr[vdrow][vdcol] == 0){
        return 1111;
    }
    
    else if (arr[vdrow][vdcol] != 0){
        return 77;
    }

    }

int sp(int sprow , int spcol , int spdir , int splen){//1010 = okay , 444 = not okay.  sp = ship placement spdir =(0 = right, 1 = down, 2 = left, 3 = up) , splen=ship length
    int spi,spj;
    
//if situation is to validte that the ship is not going out of board
switch (spdir)
{
    // RIGHT
    case 0:
        if ((spcol + splen - 1 >= 10))
            return 444;

        for (spi = 0; spi < splen; spi++)
        {
            if (vd(sprow, spcol + spi) == 77)
                return 444;
        }

        for (spi = 0; spi < splen; spi++)
        {
            arr[sprow][spcol + spi] = splen;
        }
        break;


    // DOWN
    case 1:
        if (sprow + splen - 1 >= 10)
            return 444;

        for (spi = 0; spi < splen; spi++)
        {
            if (vd(sprow + spi, spcol) == 77)
                return 444;
        }

        for (spi = 0; spi < splen; spi++)
        {
            arr[sprow + spi][spcol] = splen;
        }
        break;


    // LEFT
    case 2:
        if (spcol - (splen - 1) < 0)
            return 444;

        for (spi = 0; spi < splen; spi++)
        {
            if (vd(sprow, spcol - spi) == 77)
                return 444;
        }

        for (spi = 0; spi < splen; spi++)
        {
            arr[sprow][spcol - spi] = splen;
        }
        break;


    // UP
    case 3:
        if (sprow - (splen - 1) < 0)
            return 444;

        for (spi = 0; spi < splen; spi++)
        {
            if (vd(sprow - spi, spcol) == 77)
                return 444;
        }

        for (spi = 0; spi < splen; spi++)
        {
            arr[sprow - spi][spcol] = splen;
        }
        break;


    default:
        return 444;
}

return 1010;

}

